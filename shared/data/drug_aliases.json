  "combos": [
    {"id": "tec-dara",   "pattern": "tec[\\s\\-+]?dara",                           "components": ["teclistamab", "daratumumab"]},
    {"id": "tal-dara",   "pattern": "tal[\\s\\-+]?dara",                            "components": ["talquetamab", "daratumumab"]},
    {"id": "tec-pd",     "pattern": "tec[\\s\\-+]?(?:pom[\\s\\-+]?dex|pd(?!\\w))", "components": ["teclistamab", "pomalidomide", "dexamethasone"]},
    {"id": "tec-ld",     "pattern": "tec[\\s\\-+]?(?:len[\\s\\-+]?dex|ld(?!\\w))|\\btecd\\b", "components": ["teclistamab", "lenalidomide", "dexamethasone"]},
    {"id": "tal-pd",     "pattern": "tal[\\s\\-+]?(?:pom[\\s\\-+]?dex|pd(?!\\w))", "components": ["talquetamab", "pomalidomide", "dexamethasone"]},
    {"id": "vrd",        "pattern": "\\bvrd\\b|\\brvd\\b",                          "components": ["bortezomib", "lenalidomide", "dexamethasone"]},
    {"id": "vcd",        "pattern": "\\bvcd\\b|\\bcvd\\b",                          "components": ["bortezomib", "cyclophosphamide", "dexamethasone"]},
    {"id": "krd",        "pattern": "\\bkrd\\b|\\brkd\\b",                          "components": ["carfilzomib", "lenalidomide", "dexamethasone"]},
    {"id": "kpd",        "pattern": "\\bkpd\\b",                                    "components": ["carfilzomib", "pomalidomide", "dexamethasone"]},
    {"id": "dvrd",       "pattern": "\\bdvrd\\b|dara[\\s\\-+]?vrd",                 "components": ["daratumumab", "bortezomib", "lenalidomide", "dexamethasone"]},
    {"id": "dvcd",       "pattern": "\\bdvcd\\b|dara[\\s\\-+]?vcd",                 "components": ["daratumumab", "bortezomib", "cyclophosphamide", "dexamethasone"]},
    {"id": "drd",        "pattern": "\\bdrd\\b|dara[\\s\\-+]?rd",                   "components": ["daratumumab", "lenalidomide", "dexamethasone"]},
    {"id": "dpd",        "pattern": "\\bdpd\\b|dara[\\s\\-+]?pd(?!\\w)",            "components": ["daratumumab", "pomalidomide", "dexamethasone"]},
    {"id": "isa-pd",     "pattern": "\\bisa[\\s\\-+]?pd\\b",                        "components": ["isatuximab", "pomalidomide", "dexamethasone"]},
    {"id": "isa-krd",    "pattern": "\\bisa[\\s\\-+]?krd\\b",                       "components": ["isatuximab", "carfilzomib", "lenalidomide", "dexamethasone"]},
    {"id": "vmp",        "pattern": "\\bvmp\\b|\\bmpv\\b",                          "components": ["bortezomib", "melphalan", "prednisone"]}
