# Bitbucket Pipelines Environment Variables Template
# Copy this to your Bitbucket Repository Settings → Pipelines → Environment variables
# Replace placeholder values with your actual AWS account IDs and endpoints

# ─────────────────────────────────────────────────────────────────────────────
# AWS Account Information
# ─────────────────────────────────────────────────────────────────────────────

# AWS Account IDs for each environment
AWS_DEV_ACCOUNT_ID=111111111111
AWS_QA_ACCOUNT_ID=222222222222
AWS_PROD_ACCOUNT_ID=333333333333

# AWS Regions
AWS_DEFAULT_REGION_DEV=eu-west-1
AWS_DEFAULT_REGION_QA=eu-west-1
AWS_DEFAULT_REGION_CQA=eu-west-2
AWS_DEFAULT_REGION_PROD=eu-west-1

# AWS OIDC Role ARNs (created for Bitbucket OIDC integration)
AWS_ROLE_ARN_DEV=arn:aws:iam::111111111111:role/bitbucket-oidc-role
AWS_ROLE_ARN_QA=arn:aws:iam::222222222222:role/bitbucket-oidc-role
AWS_ROLE_ARN_PROD=arn:aws:iam::333333333333:role/bitbucket-oidc-role

# Lambda Execution Role ARNs (for creating new Lambda functions)
LAMBDA_ROLE_ARN=arn:aws:iam::111111111111:role/lambda-execution-role

# ─────────────────────────────────────────────────────────────────────────────
# OpenSearch Configuration - DEV
# ─────────────────────────────────────────────────────────────────────────────

OPENSEARCH_ENDPOINT_DEV=search-rls-dev-rhitzxwnctmuyq2l4kny5kwelu.eu-west-1.es.amazonaws.com
SEMANTIC_OBJECTS_INDEX_DEV=semantic-objects
DOCUMENT_CHUNKS_INDEX_DEV=document-chunks
CI_OBJECTS_INDEX_DEV=ci-objects
OPENSEARCH_MAXSIZE_DEV=256

# ─────────────────────────────────────────────────────────────────────────────
# OpenSearch Configuration - QA
# ─────────────────────────────────────────────────────────────────────────────

OPENSEARCH_ENDPOINT_QA=search-rls-qa-xyz.eu-west-1.es.amazonaws.com
SEMANTIC_OBJECTS_INDEX_QA=semantic-objects
DOCUMENT_CHUNKS_INDEX_QA=document-chunks
CI_OBJECTS_INDEX_QA=ci-objects
OPENSEARCH_MAXSIZE_QA=512

# ─────────────────────────────────────────────────────────────────────────────
# OpenSearch Configuration - CQA (Customer QA)
# ─────────────────────────────────────────────────────────────────────────────

OPENSEARCH_ENDPOINT_CQA=search-rls-cqa-xyz.eu-west-2.es.amazonaws.com
SEMANTIC_OBJECTS_INDEX_CQA=semantic-objects
DOCUMENT_CHUNKS_INDEX_CQA=document-chunks
CI_OBJECTS_INDEX_CQA=ci-objects
OPENSEARCH_MAXSIZE_CQA=512

# ─────────────────────────────────────────────────────────────────────────────
# OpenSearch Configuration - PROD
# ─────────────────────────────────────────────────────────────────────────────

OPENSEARCH_ENDPOINT_PROD=search-rls-prod-xyz.eu-west-1.es.amazonaws.com
SEMANTIC_OBJECTS_INDEX_PROD=semantic-objects
DOCUMENT_CHUNKS_INDEX_PROD=document-chunks
CI_OBJECTS_INDEX_PROD=ci-objects
OPENSEARCH_MAXSIZE_PROD=1024

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Apryse License Key (if using PDF processing)
# ─────────────────────────────────────────────────────────────────────────────

APRYSE_LICENSE_KEY=demo:1744408704147:6136e23d030000000053544a6ccf2b965334c4d0169bc2693bc540885b

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Hugging Face Token (for private model access)
# ─────────────────────────────────────────────────────────────────────────────

HF_TOKEN=hf_your_token_here

# ─────────────────────────────────────────────────────────────────────────────
# Setup Instructions:
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. In Bitbucket, go to: Repository Settings → Pipelines → Environment variables
# 2. For each variable above:
#    - Click "Add variable"
#    - Enter the key (e.g., AWS_DEV_ACCOUNT_ID)
#    - Enter the value (e.g., 111111111111)
#    - Leave "Secured" unchecked for non-sensitive values
#    - Check "Secured" for sensitive values (API keys, tokens)
# 3. Test the pipeline with a small push to main branch
#
# ─────────────────────────────────────────────────────────────────────────────
